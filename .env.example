# Copy to .env and change the passwords before exposing the service.
DD_ADMIN_LOGIN=admin
DD_ADMIN_PASSWORD=change-me-please
# Anyone who can reach the service can sign up; set to 0 on a shared network
DD_OPEN_REGISTRATION=1
DD_HTTP_PORT=8080

DD_PG_USER=dd
DD_PG_PASSWORD=change-me
DD_PG_PORT=5432
DD_AMQP_USER=dd
DD_AMQP_PASSWORD=change-me
DD_AMQP_PORT=5672

# Folder with run folders (manifest.json + RESULTS/BEFORE*/ + RESULTS/AFTER*/), mounted read-only into workers
DD_DATASETS_PATH=./datasets
DD_CHUNK_APPS=250
DD_WORKER_PROCS=4
DD_USER_WINDOW=4
DD_SANDBOX=strict
# Address space limit of one sandbox (RLIMIT_AS, not RSS); at 4096 DuckDB queries die with SIGSEGV
DD_SANDBOX_MEM_MB=8192

# Any OpenAI-compatible endpoint for the AI second opinion; leave empty to disable
DD_LLM_BASE_URL=
DD_LLM_API_KEY=
DD_LLM_MODEL=

# Bearer token for /metrics (empty = open inside the internal network)
DD_METRICS_TOKEN=
